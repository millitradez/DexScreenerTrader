{
  "manifest_version": 3,
  "name": "DexScreenerTrader",
  "version": "4.5",
  "description": "DexScreenerTrader v4.5 — embedded wallet, SOL & SPL, FluxBeam trade (Mainnet Beta).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DexScreenerTrader"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://api.mainnet-beta.solana.com/*",
    "https://api.fluxbeam.xyz/*",
    "https://public-api.fluxbeam.xyz/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
