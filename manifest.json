{
  "manifest_version": 3,
  "name": "DexScreener Trader",
  "version": "1.0.3",
  "description": "Trade directly from Dexscreener with integrated Solana wallet and Fluxbeam API support.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://dexscreener.com/*", "https://fluxbeam.xyz/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "main.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://dexscreener.com/*"],
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/web3.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
